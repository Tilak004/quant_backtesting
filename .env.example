# Copy this file to .env and fill in real values. Never commit .env.

# Gmail account that sends the screener alerts
GMAIL_SENDER=you@gmail.com

# 16-char Google App Password (Google Account > Security > App passwords),
# not your normal Gmail password
GMAIL_APP_PASS=xxxx xxxx xxxx xxxx

# Comma-separated list of alert recipients
ALERT_RECIPIENTS=you@gmail.com,other@gmail.com

# Optional: Financial Modeling Prep API key. The dashboard's Fundamentals tab
# shows whether it is set.
# FMP_API_KEY=your_key_here
