# =============================================================================
# NSE Quant Backtest — .gitignore
# =============================================================================

# ── SECRETS — NEVER commit these ─────────────────────────────────────────────
# NOTE: '#' only starts a comment at the START of a line. An inline comment
# becomes part of the pattern, so ".env  # blah" matches nothing. That bug is
# why .env stayed tracked and was re-committed in b09673e. Keep comments above.
.env
.env.*
*.pem
*.key
secrets/

# .env.example is safe to commit (it has no real values)
!.env.example

# ── DOWNLOADED MARKET DATA ───────────────────────────────────────────────────
# These CSVs are large, can be regenerated any time with:  python data.py
# Covers data/raw/ (OHLCV cache) and data/fundamentals/ (fundamentals cache).
data/

# ── BACKTEST OUTPUT ───────────────────────────────────────────────────────────
# Trade CSVs and charts are generated output — not source code.
# Re-run main.py to reproduce them.
results/trades_*.csv
results/OOS_best.csv
results/charts/
results/portfolio_equity.csv
# Edge check: per-ticker scenario trades are regenerable; the report and summary.csv are kept
results/edge_check/*/
results/edge_check_smoke/

# Trained ML models — regenerate with: python -m core.ml.xgb_scorer
models/
# Generated on every `python main.py` run, so it is not version-controlled.
results/summary_report.md

# ── PYTHON CACHE ──────────────────────────────────────────────────────────────
__pycache__/
# .pyc / .pyo / .pyd
*.py[cod]
*.pyo
*.pyd
*$py.class

# ── TOOL CACHES & COVERAGE ────────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# ── VIRTUAL ENVIRONMENTS ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.virtualenv/

# ── BUILD & DISTRIBUTION ──────────────────────────────────────────────────────
*.egg-info/
dist/
build/
*.egg
*.whl
MANIFEST

# ── JUPYTER NOTEBOOKS (checkpoints) ──────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── IDE & EDITOR FILES ────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── LOGS & TEMP FILES ─────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
# Ignore all logs EXCEPT the paper-trade ledger, which the daily screener
# commits back so paper trading state persists across cloud runs.
logs/*
!logs/paper_trades.csv

# ── WINDOWS SPECIFIC ──────────────────────────────────────────────────────────
desktop.ini
ehthumbs.db

# Claude Code per-user settings (shared commands/skills in .claude/ are tracked)
.claude/settings.local.json

# BMAD agent scaffolding — kept on disk, not version-controlled
_bmad/
.claude/skills/bmad-*/
